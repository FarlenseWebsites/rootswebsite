cus%2Fimg2.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg2.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-sports p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Grassroots Sports Participation</h3><p class=\"text-sm text-roots-text leading-relaxed\">Expanding regular access to sport, fitness, and play.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 2\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg3.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-sports p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Athlete Development Pathways</h3><p class=\"text-sm text-roots-text leading-relaxed\">Supporting athletes through coaching, progression planning, and exposure.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 3\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg4.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-sports p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Centres of Excellence and Residential Training</h3><p class=\"text-sm text-roots-text leading-relaxed\">Providing advanced training environments for selected young athletes.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 4\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg5.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-sports p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">School and Community Sports Ecosystems</h3><p class=\"text-sm text-roots-text leading-relaxed\">Strengthening infrastructure, coaching, and participation at the local level.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 5\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fsports%2Ffocus%2Fimg6.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-sports p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Fitness, Nutrition, and Mentorship</h3><p class=\"text-sm text-roots-text leading-relaxed\">Supporting performance through nutrition, conditioning, guidance, and care.</p></div></div></div></section><section class=\"py-16 px-6 sm:px-10 max-w-7xl mx-auto\"><div class=\"w-full\"><div class=\"mb-8 text-left\"><h2 class=\"text-3xl sm:text-4xl font-extrabold text-[#2a2a2a] tracking-tight mb-2\">Programs</h2></div><div class=\"p-6 sm:p-8\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\"><div class=\"lg:col-span-4 h-full bg-white p-4 border border-[#d9d9d9]\"><div class=\"flex flex-col gap-2\"><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer bg-[#FEF9F1] border font-semibold\" style=\"border-color:#ef7f3a;color:#1a1a1a\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-transparent\" style=\"background-color:#ef7f3a\"><div class=\"w-2 h-2 rounded-full bg-white\"></div></div><span class=\"text-sm font-medium leading-snug\">Sports Lab</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Sehatgiri</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Vision Football Academy</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">PSCA</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Sports For All (SFA)</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Games Forest</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Veer Champion League (VCL)</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Utkarsh</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Feeding India Partnership</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">AAI Grassroots Sports and Fitness Promotion Programme</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-[#4A4749]\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">MCL Grassroots Sports Development Programme</span></div></button></div></div><div class=\"lg:col-span-8 h-full bg-white border border-[#d9d9d9] p-6 sm:p-8 flex flex-col justify-between\"><div><div class=\"border-b border-gray-100 pb-5 mb-6\"><h3 class=\"text-2xl sm:text-3xl font-bold text-[#1a1a1a]\">SportsLab</h3></div><div class=\"space-y-4 text-sm sm:text-base text-[#4A4749] font-light mb-6\"><p>A grassroots sports and fitness development platform working across Punjab, Haryana, and Maharashtra.</p><p>The programme integrates school fitness modules, talent identification, Centres of Excellence, residential training pathways, career counselling, and digital monitoring.</p><p>It is designed to build a structured sports ecosystem for children and young athletes.</p><p>Sports Lab has enabled 30,000+ student engagements, 100+ government school touchpoints, and 14,000+ evening training sessions.</p></div><div class=\"pt-2 mb-2\"><div class=\"text-xs font-semibold text-roots-text mb-3\">Location(s)</div><div class=\"flex flex-wrap gap-3\"><span class=\"text-xs px-4 py-2.5 text-white\" style=\"background-color:#ef7f3a\">States: Punjab, Haryana, Maharashtra</span><span class=\"text-xs px-4 py-2.5 text-white\" style=\"background-color:#ef7f3a\">30,000+ student engagements</span><span class=\"text-xs px-4 py-2.5 text-white\" style=\"background-color:#ef7f3a\">100+ government school touchpoints</span></div></div></div></div></div><div class=\"mt-8\"><div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3\"><div class=\"group relative h-28 sm:h-32 overflow-hidden\"><img alt=\"Sports Lab orientation\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 14vw\" srcSet=\"/_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fsports%2Fsportslab%2F1.png&amp;w=2048&amp;