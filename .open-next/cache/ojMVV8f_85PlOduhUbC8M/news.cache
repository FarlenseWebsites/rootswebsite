border-gray-100 flex items-center justify-between text-left\"><div><p class=\"text-[10px] font-bold text-roots-text leading-tight\">Annual Report 2024</p><p class=\"text-[9px] text-roots-text/60\">Full Year Review</p></div><div class=\"w-5 h-5 rounded-full bg-roots-beige flex items-center justify-center text-roots-primary hover:bg-roots-primary hover:text-white transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-3 h-3\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></div></div></div><div class=\"absolute bottom-0 left-0 right-0 h-1 bg-roots-skilled rounded-b-lg\"></div></div></a></div></section><section class=\"py-12 px-6 max-w-7xl mx-auto relative group\"><div class=\"flex flex-col md:flex-row md:items-end justify-between mb-8\"><div><h2 class=\"text-2xl sm:text-3xl font-bold text-roots-text\">LinkedIn Posts</h2><p class=\"text-sm text-roots-text/70 mt-1\">Live updates and insights from our work on the ground</p></div><div class=\"flex gap-2 mt-4 md:mt-0 select-none\"><button class=\"p-2 rounded-full border border-gray-200 bg-white hover:bg-roots-primary hover:text-white transition-all shadow-sm cursor-pointer\" aria-label=\"Scroll left\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left w-5 h-5\" aria-hidden=\"true\"><path d=\"m15 18-6-6 6-6\"></path></svg></button><button class=\"p-2 rounded-full border border-gray-200 bg-white hover:bg-roots-primary hover:text-white transition-all shadow-sm cursor-pointer\" aria-label=\"Scroll right\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-right w-5 h-5\" aria-hidden=\"true\"><path d=\"m9 18 6-6-6-6\"></path></svg></button></div></div><div class=\"flex gap-6 overflow-x-auto pb-6 scroll-smooth snap-x scrollbar-none [&amp;::-webkit-scrollbar]:hidden [-ms-overflow-style:none] [scrollbar-width:none]\"><a class=\"flex-shrink-0 snap-start block\" href=\"/news/linkedin/1\"><div class=\"w-[280px] h-[390px] bg-white border border-gray-200/85 shadow-md hover:shadow-xl rounded-lg overflow-hidden flex flex-col justify-between text-left transition-all duration-300 hover:-translate-y-1.5\"><div class=\"p-3 flex items-center justify-between border-b border-gray-100\"><div class=\"flex items-center gap-2\"><div class=\"relative w-8 h-8 rounded-full border border-gray-100 overflow-hidden bg-gray-50 flex items-center justify-center\"><img alt=\"Roots logo\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain p-1\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"32px\" srcSet=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=16&amp;q=75 16w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=32&amp;q=75 32w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=48&amp;q=75 48w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=64&amp;q=75 64w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=3840&amp;q=75\"/></div><div><p class=\"text-xs font-bold text-roots-text leading-tight\">Roots Foundation</p><p class=\"text-[10px] text-gray-400\">2d ago<!-- --> • Edited</p></div></div><svg class=\"w-4 h-4 text-roots-primary fill-roots-primary\" viewBox=\"0 0 24 24\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z\"></path></svg></div><div class=\"px-3 pt-2 flex-1 overflow-hidden\"><p class=\"text-[11px] sm:text-[12px] text-roots-text leading-relaxed line-clamp-3 font-normal\">Our grassroots sports programs continue to expand, offering children from rural areas access to professional coaching, sports equipment, and competitive tournaments. Witnessing their smiles as they lift the trophy is why we do what we do. #SportsForAll #GrassrootsImpact #PhysicalLiteracy</p></div><div class=\"relative w-full h-[180px] bg-gray-50 border-y border-gray-100\"><img alt=\"LinkedIn Post visual\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"280px\" srcSet=\"/_next/image?url=%2Fimages%2Fimg-2.jpg&amp;w=16&amp;q=75 16w, /_next/image?url=%2Fimages%2Fimg-2.jpg&amp;w=32&amp;q=75 32w, /_next/image?url=%2Fimages%2Fimg-2.jpg&amp;w=48&amp;q=75 48w, /_next/image?url=%2Fimages%2Fimg-2.jpg&amp;w=64&amp;q=75 64w, /_next/image?url=%2Fimages%