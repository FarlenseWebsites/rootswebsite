nsparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fteams%2Fridhima.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fteams%2Fridhima.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fteams%2Fridhima.png&amp;w=3840&amp;q=75\"/></div><div class=\"flex h-36 flex-col justify-between\"><div><h4 class=\"text-lg font-medium text-roots-primary leading-tight\">Ridhima Bahuguna</h4><p class=\"mt-2 text-xs text-roots-primary leading-6 max-w-[180px]\">Founder and President</p></div><a href=\"https://linkedin.com\" target=\"_blank\" rel=\"noopener noreferrer\" class=\"text-roots-primary hover:opacity-70 transition-opacity\"><svg stroke=\"currentColor\" fill=\"currentColor\" stroke-width=\"0\" viewBox=\"0 0 448 512\" height=\"1em\" width=\"1em\" xmlns=\"http://www.w3.org/2000/svg\"><path d=\"M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z\"></path></svg></a></div></div></div></div><div class=\"mb-16\"><h3 class=\"text-2xl mb-8\">Advisory Board</h3><div class=\"grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-3 gap-10\"><div class=\"flex items-start gap-5\"><div class=\"relative w-36 h-36 shrink-0 overflow-hidden\"><img alt=\"A.P Sinha\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contai