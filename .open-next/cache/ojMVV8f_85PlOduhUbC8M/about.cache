{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/about/layout,_N_T_/about/page,_N_T_/about"}},"html":"<!DOCTYPE html><!--ojMVV8f_85PlOduhUbC8M--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fabout%2Fhands.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=3840&amp;q=75 3840w\" imageSizes=\"100vw\"/><link rel=\"preload\" as=\"image\" href=\"/about/sustainablepoints.svg\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fabout%2Fmap.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=3840&amp;q=75 3840w\" imageSizes=\"100vw\"/><link rel=\"stylesheet\" href=\"/_next/static/css/61e6ba784b9e8c83.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-30d4efee758f00d3.js\"/><script src=\"/_next/static/chunks/bde6a985-6be4c19b917583eb.js\" async=\"\"></script><script src=\"/_next/static/chunks/212-197509c14b256481.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9a461252f4b9a221.js\" async=\"\"></script><script src=\"/_next/static/chunks/22-81df8e529db65d46.js\" async=\"\"></script><script src=\"/_next/static/chunks/650-59bd29c2fde8991c.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-2c4630243a413d2a.js\" async=\"\"></script><script src=\"/_next/static/chunks/e9619662-b9e0a5fdfa9aa626.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/about/page-054d9180472fe19b.js\" async=\"\"></script><title>Roots Foundation</title><meta name=\"description\" content=\"Building structured, on-ground programs that address real needs and deliver sustained outcomes.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"150x67\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-[#FEF9F1] text-[#4A4749] flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"w-full bg-roots-beige sticky top-0 z-50 shadow-sm border-b border-gray-200/20\"><div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\"><a class=\"flex-shrink-0\" href=\"/\"><img alt=\"Roots Foundation\" loading=\"lazy\" width=\"120\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75\"/></a><ul class=\"hidden md:flex items-center gap-8\"><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/\">Home</a></li><li><a class=\"text-sm transition-colors text-roots-primary font-semibold\" href=\"/about\">About Us</a></li><li class=\"relative group py-6\"><div class=\"flex items-center gap-1 cursor-pointer\"><a class=\"text-sm transition-colors flex items-center gap-1.5 text-roots-text font-medium hover:text-roots-primary\" href=\"/impact\">Impact Hub<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a></div></li><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/governance\">Governance</a></li><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/news\">News and Insights</a></li></ul><a class=\"hidden md:inline-flex items-center px-5 py-2.5 bg-roots-primary text-white text-sm font-semibold rounded hover:opacity-90 transition-opacity\" href=\"/partner\">Partner With Us</a><button class=\"md:hidden p-2 text-roots-text hover:text-roots-primary transition-colors focus:outline-none cursor-pointer\" aria-label=\"Toggle menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-6 h-6\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></nav><main class=\"flex-1\"><div class=\"bg-[#FEF9F1] min-h-screen text-[#4A4749] pb-16 font-sans\"><section class=\" pt-10 pb-12 px-10 max-w-7xl mx-auto  \"><div class=\"grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 items-start \"><div class=\"space-y-4 \"><span class=\"text-4xl sm:text-3xl font-bold tracking-widest text-[roots-text]\">About Us</span><h1 class=\"text-xl text-[roots-text] mt-5\">Turning Grassroots Potential<br/>Into Lasting Change</h1></div><div class=\"space-y-6 text-[#4A4749]/85 font-light leading-relaxed text-sm sm:text-base md:pt-8\"><p>Roots Foundation is a social impact organisation working at the grassroots to create sustainable, locally relevant solutions.<br/><br/>Since 2012, we have designed and delivered programmes across sustainable agriculture, education, sports, healthcare, skill development, and community development.<br/><br/>Our work begins with local realities. We collaborate with communities, partners, and public institutions to strengthen capacities, improve access, and build systems that can continue beyond the life of a project. Through long-term, measurable interventions, we help create greater opportunity, stronger local ownership, and lasting change.</p></div></div></section><section class=\"relative w-full h-[70vh] md:h-[60vh] lg:h-[40vw] overflow-hidden\"><img alt=\"Celebrating the Joy of Sharing\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fhands.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fhands.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fhands.jpg&amp;w=3840&amp;q=75\"/><div class=\"relative z-20 max-w-7xl mx-auto mt-10 px-6 w-full text-white grid grid-cols-1 md:grid-cols-2 gap-8 \"><div><h2 class=\"text-4xl sm:text-xl md:text-3xl leading-tight font-normal\">Celebrating the <span class=\"font-bold\">Joy of<br/>Sharing</span></h2></div><div class=\"space-y-10 \"><p class=\"text-white/80 font-light text-sm sm:text-base leading-relaxed md:mt-15\">The joy of sharing goes beyond traditional implementation of programs. We actively co-funding projects when required to ensure change happens. This unique approach reflects our deep commitment and ownership mindset, ensuring that every initiative we undertake is not just executed but sustained with accountability.</p><div class=\"text-5xl font-extrabold text-white flex items-center gap-1\">100 +</div><p class=\"text-sm  tracking-wider text-white mt-1\">Projects supported through collaboration</p></div></div></section><section class=\"py-16\"><div class=\"max-w-7xl mx-auto px-10\"><h2 class=\"text-3xl font-medium tracking-tight text-roots-text mb-12 text-center\">How We Work</h2></div><div class=\"bg-roots-primary text-white py-15\"><div class=\"max-w-7xl mx-auto px-10\"><div class=\"hidden md:block relative\"><div class=\"absolute top-4 left-[12%] right-[12%] h-[2px] bg-white\"></div><div class=\"grid grid-cols-3 gap-10 relative z-10\"><div class=\"flex flex-col items-center text-center\"><div class=\"relative mb-6\"><div class=\"w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div></div><h3 class=\"text-lg font-bold mb-2\">The Launchpad</h3><p class=\"text-white/80 text-sm leading-relaxed\">Insights to Imapct</p></div><div class=\"flex flex-col items-center text-center\"><div class=\"relative mb-6\"><div class=\"w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div></div><h3 class=\"text-lg font-bold mb-2\">The Catalyst/ Fulcrum</h3><p class=\"text-white/80 text-sm leading-relaxed\">Leverage all Stakeholders</p></div><div class=\"flex flex-col items-center text-center\"><div class=\"relative mb-6\"><div class=\"w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div></div><h3 class=\"text-lg font-bold mb-2\">The Anchor</h3><p class=\"text-white/80 text-sm leading-relaxed\">Own the project (Multiplier Effect)</p></div></div></div><div class=\"md:hidden relative ml-4\"><div class=\"absolute left-4 top-0 bottom-0 w-[2px] bg-white\"></div><div class=\"space-y-10\"><div class=\"relative flex items-start gap-6\"><div class=\"relative z-10 flex-shrink-0 w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div><div class=\"pt-1\"><h3 class=\"text-base font-bold mb-1\">The Launchpad</h3><p class=\"text-sm text-white/80\">Insights to Imapct</p></div></div><div class=\"relative flex items-start gap-6\"><div class=\"relative z-10 flex-shrink-0 w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div><div class=\"pt-1\"><h3 class=\"text-base font-bold mb-1\">The Catalyst/ Fulcrum</h3><p class=\"text-sm text-white/80\">Leverage all Stakeholders</p></div></div><div class=\"relative flex items-start gap-6\"><div class=\"relative z-10 flex-shrink-0 w-8 h-8 rounded-full bg-white flex items-center justify-center\"><div class=\"w-3 h-3 rounded-full bg-[roots-primary]\"></div></div><div class=\"pt-1\"><h3 class=\"text-base font-bold mb-1\">The Anchor</h3><p class=\"text-sm text-white/80\">Own the project (Multiplier Effect)</p></div></div></div></div></div></div></section><section class=\" px-10 max-w-7xl mx-auto\"><div class=\"text-left max-w-3xl mb-14\"><h2 class=\"text-3xl font-bold tracking-tight text-roots-text mb-4\">Our Strategic Focus</h2><p class=\"text-base text-roots-text leading-relaxed\">We work from strategy to last-mile delivery, combining local<br class=\"hidden sm:block\"/>knowledge, strong partnerships, and accountable implementation.</p></div><div class=\"sm:hidden space-y-5\"><div class=\"border-2 border-[#09569a] p-5 flex items-center gap-4\"><img alt=\"Community-Centric Approach\" loading=\"lazy\" width=\"60\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"flex-shrink-0\" style=\"color:transparent\" src=\"/about/community.svg\"/><div><h3 class=\"text-[#09569a] font-semibold mb-2\">Community-Centric Approach</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">We listen to local voices and design programmes around community priorities.</p></div></div><div class=\"border-2 border-[#09569a] p-5 flex items-center gap-4\"><img alt=\"Partnership-Driven Impact\" loading=\"lazy\" width=\"60\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"flex-shrink-0\" style=\"color:transparent\" src=\"/about/partnership.svg\"/><div><h3 class=\"text-[#09569a] font-semibold mb-2\">Partnership-Driven Impact</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">We work with corporates, public institutions, and communities to develop aligned solutions.</p></div></div><div class=\"border-2 border-[#09569a] p-5 flex items-center gap-4\"><img alt=\"Scalability with Integrity\" loading=\"lazy\" width=\"60\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"flex-shrink-0\" style=\"color:transparent\" src=\"/about/scalability.svg\"/><div><h3 class=\"text-[#09569a] font-semibold mb-2\">Scalability with Integrity</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">Building models that can be replicated across India without compromising authenticity.</p></div></div></div><div class=\"hidden sm:grid sm:grid-cols-3 items-center\"><div class=\"border-2 border-[#09569a] p-5 h-full\"><h3 class=\"text-[#09569a] font-semibold mb-2\">Community-Centric Approach</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">We listen to local voices and design programmes around community priorities.</p></div><div class=\"flex justify-center\"><img alt=\"Partnership\" loading=\"lazy\" width=\"90\" height=\"90\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" src=\"/about/partnership.svg\"/></div><div class=\"border-2 border-[#09569a] p-5 h-full\"><h3 class=\"text-[#09569a] font-semibold mb-2\">Scalability with Integrity</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">Building models that can be replicated across India without compromising authenticity.</p></div><div class=\"flex justify-center\"><img alt=\"Community\" loading=\"lazy\" width=\"90\" height=\"90\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" src=\"/about/community.svg\"/></div><div class=\"border-2 border-[#09569a] p-5 h-full\"><h3 class=\"text-[#09569a] font-semibold mb-2\">Partnership-Driven Impact</h3><p class=\"text-[#09569a] text-sm leading-relaxed\">We work with corporates, public institutions, and communities to develop aligned solutions.</p></div><div class=\"flex justify-center\"><img alt=\"Scalability\" loading=\"lazy\" width=\"90\" height=\"90\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" src=\"/about/scalability.svg\"/></div></div></section><section class=\"max-w-7xl mx-auto px-10 py-20\"><div class=\"space-y-20\"><div class=\"grid md:grid-cols-2 gap-12 items-center \"><div class=\"relative w-full h-[240px] md:h-[260px] overflow-hidden\"><img alt=\"Stronger Partner Confidence\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fimg25.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"max-w-md \"><h3 class=\"text-2xl font-semibold text-roots-text mb-4\">Stronger Partner Confidence</h3><p class=\"text-[#666] leading-7\">Shared investment builds trust and reflects confidence in the project.</p></div></div><div class=\"grid md:grid-cols-2 gap-12 items-center md:[&amp;&gt;*:first-child]:order-2\"><div class=\"relative w-full h-[240px] md:h-[260px] overflow-hidden\"><img alt=\"Greater Sustainability\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fimg27.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"max-w-md md:text-right md:justify-self-start\"><h3 class=\"text-2xl font-semibold text-roots-text mb-4\">Greater Sustainability</h3><p class=\"text-[#666] leading-7\">Multiple funding partners strengthen programme continuity and reduce dependence on a single source.</p></div></div><div class=\"grid md:grid-cols-2 gap-12 items-center \"><div class=\"relative w-full h-[240px] md:h-[260px] overflow-hidden\"><img alt=\"Shared Accountability\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fimg26.jpg&amp;w=3840&amp;q=75\"/></div><div class=\"max-w-md \"><h3 class=\"text-2xl font-semibold text-roots-text mb-4\">Shared Accountability</h3><p class=\"text-[#666] leading-7\">Co-funding aligns partners around measurable outcomes and the responsible use of resources.</p></div></div></div></section><section class=\"bg-roots-primary text-white\"><div class=\"max-w-7xl mx-auto px-10 py-14\"><div class=\"grid grid-cols-1 md:grid-cols-3 gap-10 items-start\"><div><h2 class=\"text-3xl font-semibold\">Shared Commitment</h2></div><div class=\"md:col-span-2\"><p class=\"text-lg leading-relaxed text-white/90 max-w-2xl\">We actively co-fund projects where needed, sharing responsibility with our partners and strengthening our commitment to long-term outcomes.</p><div class=\"mt-8\"><h3 class=\"text-6xl font-bold leading-none\">100<span class=\"ml-1\">+</span></h3><p class=\"mt-2 text-lg text-white/90\">Projects supported through collaboration</p></div></div></div></div></section><section class=\"max-w-7xl mx-auto px-10 py-20\"><div class=\"mb-12\"><h2 class=\"text-4xl font-semibold text-roots-text\">Our Core Values</h2><p class=\"mt-3 text-[#666] max-w-2xl\">We are committed to delivering every project with precision and accountability at the last mile.</p></div><div class=\"grid lg:grid-cols-5 items-start\"><div class=\"lg:col-span-2\"><div class=\"relative w-full h-[50vh] md:h-[40vw] overflow-hidden\"><img alt=\"Mustard Field\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fmustard.jpg&amp;w=3840&amp;q=75\"/></div></div><div class=\"lg:col-span-3 grid grid-cols-1 sm:grid-cols-2\"><div class=\"\n                flex flex-col items-center text-center\n                px-6 py-5\n\n                sm:border-r sm:border-[#7d7d7d]\n                sm:border-b sm:border-[#7d7d7d]\n              \"><img alt=\"Ownership Mindset\" loading=\"lazy\" width=\"58\" height=\"58\" decoding=\"async\" data-nimg=\"1\" class=\"mb-5\" style=\"color:transparent\" src=\"/about/ownership.svg\"/><h3 class=\"text-xl font-semibold text-roots-text mb-3\">Ownership Mindset</h3><p class=\"text-roots-text leading-7 text-sm max-w-xs\">Going beyond traditional implementation by actively co-funding projects where required. This demonstrates our deep commitment and ownership mindset.</p></div><div class=\"\n                flex flex-col items-center text-center\n                px-6 py-5\n\n                \n                sm:border-b sm:border-[#7d7d7d]\n              \"><img alt=\"Impact First\" loading=\"lazy\" width=\"58\" height=\"58\" decoding=\"async\" data-nimg=\"1\" class=\"mb-5\" style=\"color:transparent\" src=\"/about/impactfirst.svg\"/><h3 class=\"text-xl font-semibold text-roots-text mb-3\">Impact First</h3><p class=\"text-roots-text leading-7 text-sm max-w-xs\">Our work is guided by measurable social returns and sustainable change.</p></div><div class=\"\n                flex flex-col items-center text-center\n                px-6 py-5\n\n                sm:border-r sm:border-[#7d7d7d]\n                \n              \"><img alt=\"Integrity\" loading=\"lazy\" width=\"58\" height=\"58\" decoding=\"async\" data-nimg=\"1\" class=\"mb-5\" style=\"color:transparent\" src=\"/about/integrity.svg\"/><h3 class=\"text-xl font-semibold text-roots-text mb-3\">Integrity</h3><p class=\"text-roots-text leading-7 text-sm max-w-xs\">We maintain transparency and trust in every relationship with communities, donors, and partners.</p></div><div class=\"\n                flex flex-col items-center text-center\n                px-6 py-5\n\n                \n                \n              \"><img alt=\"Empathy\" loading=\"lazy\" width=\"58\" height=\"58\" decoding=\"async\" data-nimg=\"1\" class=\"mb-5\" style=\"color:transparent\" src=\"/about/empathy.svg\"/><h3 class=\"text-xl font-semibold text-roots-text mb-3\">Empathy</h3><p class=\"text-roots-text leading-7 text-sm max-w-xs\">We listen deeply, respect local realities, and co-create solutions with the communities we serve.</p></div></div></div></section><section class=\"max-w-7xl mx-auto px-6 py-10\"><div class=\"ml-4\"><h2 class=\"text-3xl md:text-4xl font-medium text-roots-text leading-tight\">We work across SDGs</h2><p class=\"mt-6 text-[#555] text-lg leading-8 max-w-sm\">We are committed to the UN SDG 2030 mission and continue to expand our impact footprint.</p></div><div class=\"mt-8 -mx-6 px-6 overflow-x-auto sm:overflow-visible\"><div class=\"relative w-[640px] sm:w-full aspect-[16/7.5] sm:aspect-[16/6] lg:aspect-[16/5]\"><img alt=\"UN Sustainable Development Goals\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/about/sustainablepoints.svg\"/></div></div></section><section class=\"py-16 px-10 font-sans\"><div class=\"max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-12 items-start\"><div class=\"lg:col-span-2\"><h2 class=\"inline-block text-3xl font-medium text-roots-text\">Our Presence</h2><p class=\"mt-4 text-[#4A4749]\">We work across India in sectors</p><div class=\"mt-8 grid grid-cols-2 lg:grid-cols-1 gap-x-6 gap-y-5\"><div class=\"flex items-start gap-4\"><svg width=\"22\" height=\"30\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"shrink-0 mt-0.5\"><path d=\"M12 0C5.37258 0 0 5.37258 0 12C0 21 12 32 12 32C12 32 24 21 24 12C24 5.37258 18.6274 0 12 0Z\" fill=\"#6b9c3e\"></path><circle cx=\"12\" cy=\"11.5\" r=\"4.5\" fill=\"white\"></circle></svg><span class=\"text-sm font-medium text-[#4A4749] whitespace-pre-line leading-[1.4]\">Sustainable\nAgriculture</span></div><div class=\"flex items-start gap-4\"><svg width=\"22\" height=\"30\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"shrink-0 mt-0.5\"><path d=\"M12 0C5.37258 0 0 5.37258 0 12C0 21 12 32 12 32C12 32 24 21 24 12C24 5.37258 18.6274 0 12 0Z\" fill=\"#745199\"></path><circle cx=\"12\" cy=\"11.5\" r=\"4.5\" fill=\"white\"></circle></svg><span class=\"text-sm font-medium text-[#4A4749] whitespace-pre-line leading-[1.4]\">Community\nDevelopment</span></div><div class=\"flex items-start gap-4\"><svg width=\"22\" height=\"30\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"shrink-0 mt-0.5\"><path d=\"M12 0C5.37258 0 0 5.37258 0 12C0 21 12 32 12 32C12 32 24 21 24 12C24 5.37258 18.6274 0 12 0Z\" fill=\"#c72761\"></path><circle cx=\"12\" cy=\"11.5\" r=\"4.5\" fill=\"white\"></circle></svg><span class=\"text-sm font-medium text-[#4A4749] whitespace-pre-line leading-[1.4]\">Skill\nDevelopment</span></div><div class=\"flex items-start gap-4\"><svg width=\"22\" height=\"30\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"shrink-0 mt-0.5\"><path d=\"M12 0C5.37258 0 0 5.37258 0 12C0 21 12 32 12 32C12 32 24 21 24 12C24 5.37258 18.6274 0 12 0Z\" fill=\"#e88d14\"></path><circle cx=\"12\" cy=\"11.5\" r=\"4.5\" fill=\"white\"></circle></svg><span class=\"text-sm font-medium text-[#4A4749] whitespace-pre-line leading-[1.4]\">Education</span></div><div class=\"flex items-start gap-4\"><svg width=\"22\" height=\"30\" viewBox=\"0 0 24 32\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" class=\"shrink-0 mt-0.5\"><path d=\"M12 0C5.37258 0 0 5.37258 0 12C0 21 12 32 12 32C12 32 24 21 24 12C24 5.37258 18.6274 0 12 0Z\" fill=\"#3174b5\"></path><circle cx=\"12\" cy=\"11.5\" r=\"4.5\" fill=\"white\"></circle></svg><span class=\"text-sm font-medium text-[#4A4749] whitespace-pre-line leading-[1.4]\">Sports</span></div></div></div><div class=\"lg:col-span-3\"><div class=\"relative w-full h-[70vw] sm:h-[55vw] lg:h-[42vw]\"><img alt=\"Map of India showing our presence across sectors\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fabout%2Fmap.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fabout%2Fmap.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fabout%2Fmap.png&amp;w=3840&amp;q=75\"/></div></div></div></section><section class=\"max-w-7xl mx-auto px-10 py-5 sm:py-1 md:py-10\"><h2 class=\"text-4xl font-medium text-roots-text mb-14\">Team</h2><div class=\"mb-16\"><h3 class=\"text-2xl  mb-8\">Founders</h3><div class=\"grid grid-cols-1 md:grid-cols-3 gap-10\"><div class=\"flex items-start gap-5\"><div class=\"relative w-36 h-36 shrink-0 overflow-hidden\"><img alt=\"Ritwik Bahuguna\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100