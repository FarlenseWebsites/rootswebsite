{"type":"app","meta":{"headers":{"x-nextjs-stale-time":"300","x-nextjs-prerender":"1","x-next-cache-tags":"_N_T_/layout,_N_T_/governance/layout,_N_T_/governance/page,_N_T_/governance"}},"html":"<!DOCTYPE html><!--aa_4_D4D0ueIN_ccYlX_Q--><html lang=\"en\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"preload\" as=\"image\" imageSrcSet=\"/_next/image?url=%2Fgovernance%2Ftable.png&amp;w=1920&amp;q=75 1x, /_next/image?url=%2Fgovernance%2Ftable.png&amp;w=3840&amp;q=75 2x\"/><link rel=\"preload\" as=\"image\" href=\"/governance/year25.svg\"/><link rel=\"preload\" as=\"image\" href=\"/governance/year24.svg\"/><link rel=\"preload\" as=\"image\" href=\"/governance/year23.svg\"/><link rel=\"stylesheet\" href=\"/_next/static/css/4344ea538f8e97be.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-30d4efee758f00d3.js\"/><script src=\"/_next/static/chunks/bde6a985-6be4c19b917583eb.js\" async=\"\"></script><script src=\"/_next/static/chunks/212-197509c14b256481.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-9a461252f4b9a221.js\" async=\"\"></script><script src=\"/_next/static/chunks/22-81df8e529db65d46.js\" async=\"\"></script><script src=\"/_next/static/chunks/650-59bd29c2fde8991c.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-b21a8a2f02c50ac6.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/governance/page-8da94dd946f19e76.js\" async=\"\"></script><title>Roots Foundation</title><meta name=\"description\" content=\"Building structured, on-ground programs that address real needs and deliver sustained outcomes.\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"150x67\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"min-h-screen bg-[#FEF9F1] text-[#4A4749] flex flex-col\"><div hidden=\"\"><!--$--><!--/$--></div><nav class=\"w-full bg-roots-beige sticky top-0 z-50 shadow-sm border-b border-gray-200/20\"><div class=\"max-w-7xl mx-auto px-6 h-20 flex items-center justify-between\"><a class=\"flex-shrink-0\" href=\"/\"><img alt=\"Roots Foundation\" loading=\"lazy\" width=\"120\" height=\"60\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75\"/></a><ul class=\"hidden md:flex items-center gap-8\"><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/\">Home</a></li><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/about\">About Us</a></li><li class=\"relative group py-6\"><div class=\"flex items-center gap-1 cursor-pointer\"><a class=\"text-sm transition-colors flex items-center gap-1.5 text-roots-text font-medium hover:text-roots-primary\" href=\"/impact/agriculture\">Impact Hub<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down w-4 h-4 transition-transform duration-200\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></a></div></li><li><a class=\"text-sm transition-colors text-roots-primary font-semibold\" href=\"/governance\">Governance</a></li><li><a class=\"text-sm transition-colors text-roots-text font-medium hover:text-roots-primary\" href=\"/news\">News and Insights</a></li></ul><a class=\"hidden md:inline-flex items-center px-5 py-2.5 bg-roots-primary text-white text-sm font-semibold rounded hover:opacity-90 transition-opacity\" href=\"/partner\">Partner With Us</a><button class=\"md:hidden p-2 text-roots-text hover:text-roots-primary transition-colors focus:outline-none cursor-pointer\" aria-label=\"Toggle menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu w-6 h-6\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div></nav><main class=\"flex-1\"><div class=\"bg-roots-beige min-h-screen mx-auto  p-10\"><section class=\"pt-12 sm:pt-16 pb-6 px-4 sm:px-6 max-w-7xl mx-auto text-left\"><div class=\"max-w-4xl\"><h1 class=\"text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#1a1a1a] mb-3\">Governance</h1><p class=\"text-base sm:text-lg md:text-xl text-[#4A4749]/80 font-light leading-relaxed\">Turning Grassroots Potential Into Lasting Change</p></div></section><section class=\"p-10  max-w-7xl mx-auto\"><div class=\"grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12\"><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Ethical Governance Framework\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/ethical.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Ethical Governance Framework</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Terms of reference guidelines are designed to evaluate compliance across key statutory requirements, ensuring key aspects of integrity are maintained.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Values-Driven Conduct\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/values.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Values-Driven Conduct</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Guiding behavior from standard codes to deep ethical alignment, promoting transparency, accountability, and professional conduct across operations.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Board &amp; Leadership Oversight\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/board.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Board &amp; Leadership Oversight</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Strategic oversight and leadership through committees, advisors, and audits, aligning programs with organization objectives, maintaining code values and core scaling goals.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Transparency &amp; Disclosures\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/transparency.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Transparency &amp; Disclosures</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Sharing reports, audits, and program metrics in public domains, providing stakeholders with clear insights into funds deployment and program outcomes.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Independant Assurance Mechanisms\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/independent.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Independant Assurance Mechanisms</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">External assessment, audits, and feedback channels, providing objective assurance on compliance, efficiency, and effectiveness of operations.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Robust Monitoring &amp; Evaluation Systems\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/robust.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Robust Monitoring &amp; Evaluation Systems</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Track, measure, and analyze on-ground data, real-time monitoring and reporting, ensure projects remain efficient, adaptable, and learning-focused.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Risk Management &amp; Internal Controls\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/risk.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Risk Management &amp; Internal Controls</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Proactive risk assessment, mitigation strategies, and internal check mechanisms to safeguard resources, maintain integrity, and ensure project compliance.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Stakeholder-Centric Governance\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/stakeholder.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Stakeholder-Centric Governance</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Empowering local communities and on-ground stakeholders, prioritizing local needs, and tracking feedbacks, active participation makes governance robust.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Responsible Partnerships\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/responsible.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Responsible Partnerships</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Structuring collaborations through agreements, transparent resource allocation, and mutual accountability, aligning values to deliver long-term impact.</p></div></div><div class=\"flex flex-col sm:flex-row gap-4 sm:gap-5 items-start group\"><div class=\"shrink-0\"><img alt=\"Sustainable Program Governance\" loading=\"lazy\" width=\"64\" height=\"64\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain w-12 h-12 sm:w-16 sm:h-16\" style=\"color:transparent\" src=\"/governance/sustainable.svg\"/></div><div class=\"flex-1\"><h3 class=\"text-base sm:text-lg font-bold text-[#09569a] mb-2 leading-tight\">Sustainable Program Governance</h3><p class=\"text-sm text-[#4A4749]/80 leading-relaxed font-light\">Systematic design that ensures post-implementation transition to local leadership, building community ownership for longevity beyond the project life cycle.</p></div></div></div></section><section class=\"p-10  max-w-7xl mx-auto space-y-8 sm:space-y-12\"><div><h2 class=\"text-2xl sm:text-3xl font-bold text-roots-text mb-2\">Financial Snapshot</h2></div><div class=\"w-full overflow-x-auto min-h-[100px]\"><div class=\"min-w-[600px] w-full\"><div class=\"w-full flex justify-center bg-transparent select-none\"><img alt=\"Overall Projects&#x27; Value\" width=\"1250\" height=\"703\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Fgovernance%2Ftable.png&amp;w=1920&amp;q=75 1x, /_next/image?url=%2Fgovernance%2Ftable.png&amp;w=3840&amp;q=75 2x\" src=\"/_next/image?url=%2Fgovernance%2Ftable.png&amp;w=3840&amp;q=75\"/></div></div></div><div><h2 class=\"text-xl sm:text-2xl font-light text-roots-text mb-2\">% Contribution for each thematic area to the overall T/O</h2></div><div class=\"rounded-xl border border-gray-200 shadow-sm overflow-hidden bg-white/50\"><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 divide-y md:divide-y-0 md:divide-x divide-gray-200\"><div class=\"p-4 sm:p-6\"><div class=\"w-full flex flex-col items-center bg-transparent select-none h-full\"><div class=\"w-full p-6 flex justify-center items-center flex-1\"><div class=\"w-full max-w-[280px]\"><img alt=\"FY 2025 - 26\" width=\"442\" height=\"395\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain\" style=\"color:transparent\" src=\"/governance/year25.svg\"/></div></div><div class=\"w-full border-t border-gray-200 bg-gray-50/20 text-center text-sm font-semibold text-[#4A4749] py-3 mt-auto\">FY 2025 - 26</div></div></div><div class=\"p-4 sm:p-6\"><div class=\"w-full flex flex-col items-center bg-transparent select-none h-full\"><div class=\"w-full p-6 flex justify-center items-center flex-1\"><div class=\"w-full max-w-[280px]\"><img alt=\"FY 2024 - 25\" width=\"442\" height=\"395\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain\" style=\"color:transparent\" src=\"/governance/year24.svg\"/></div></div><div class=\"w-full border-t border-gray-200 bg-gray-50/20 text-center text-sm font-semibold text-[#4A4749] py-3 mt-auto\">FY 2024 - 25</div></div></div><div class=\"p-4 sm:p-6 md:col-span-2 lg:col-span-1 border-t md:border-t-0 lg:border-t-0\"><div class=\"w-full flex flex-col items-center bg-transparent select-none h-full\"><div class=\"w-full p-6 flex justify-center items-center flex-1\"><div class=\"w-full max-w-[280px]\"><img alt=\"FY 2023 - 24\" width=\"442\" height=\"395\" decoding=\"async\" data-nimg=\"1\" class=\"w-full h-auto object-contain\" style=\"color:transparent\" src=\"/governance/year23.svg\"/></div></div><div class=\"w-full border-t border-gray-200 bg-gray-50/20 text-center text-sm font-semibold text-[#4A4749] py-3 mt-auto\">FY 2023 - 24</div></div></div></div></div><div class=\"pt-2\"><div class=\"flex flex-wrap justify-center sm:justify-start gap-x-4 sm:gap-x-6 gap-y-3 text-xs sm:text-sm font-semibold\"><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#75bc20\"></span><span class=\"leading-tight\">Sustainable Agriculture &amp; Environment</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#febc20\"></span><span class=\"leading-tight\">Education</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#d32f2f\"></span><span class=\"leading-tight\">Community Development</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#ef7f3a\"></span><span class=\"leading-tight\">Sports</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#dc3b83\"></span><span class=\"leading-tight\">Skill Development</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#8353ec\"></span><span class=\"leading-tight\">Healthcare</span></div><div class=\"flex items-center gap-2 text-[#4A4749]\"><span class=\"w-4 h-4 sm:w-5 sm:h-5 shrink-0 rounded-sm\" style=\"background-color:#4A4749\"></span><span class=\"leading-tight\">Others</span></div></div></div></section></div><!--$--><!--/$--></main><footer class=\"bg-roots-footer-gray\"><div class=\"max-w-7xl mx-auto px-10 py-10\"><div class=\"mb-10\"><a class=\"inline-block\" href=\"/\"><img alt=\"Roots Foundation\" loading=\"lazy\" width=\"110\" height=\"55\" decoding=\"async\" data-nimg=\"1\" class=\"object-contain\" style=\"color:transparent\" srcSet=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=128&amp;q=75 1x, /_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75 2x\" src=\"/_next/image?url=%2Flogos%2Frootslogo.png&amp;w=256&amp;q=75\"/></a></div><div class=\"grid grid-cols-1 md:grid-cols-4 gap-10\"><div class=\"flex flex-col gap-6\"><div><p class=\"text-sm text-[#4A4749] mb-3 leading-snug\">Sign up to receive newsletter</p><div class=\"flex border border-[#09569a] rounded overflow-hidden\"><input type=\"email\" placeholder=\"Enter Your Mail\" class=\"flex-1 px-3 py-2 text-sm text-[#4A4749] bg-white outline-none placeholder-gray-400\" value=\"\"/><button class=\"px-4 py-2 bg-[#09569a] text-white text-sm font-medium hover:opacity-90 transition-opacity\">Submit</button></div><p class=\"text-xs text-[#4A4749] mt-3 leading-relaxed\">By subscribing, you agree to our Privacy Policy and consent to receive updates from us.</p></div><div class=\"flex items-start gap-3\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"