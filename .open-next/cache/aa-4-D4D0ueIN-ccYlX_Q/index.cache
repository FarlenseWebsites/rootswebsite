bject-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/award/AwardBadge.svg\"/></div><p class=\"text-xs sm:text-sm font-roots-text tracking-tight\">2021</p><h3 class=\"text-base sm:text-lg font-semibold font-roots-text mb-1\">Best NGO Award</h3><p class=\"text-xs sm:text-sm text-[#4A4749]/80 font-medium\">INDIA</p></div><div class=\"flex flex-col items-center\"><div class=\"relative w-28 h-28 flex items-center justify-center mb-5\"><img alt=\"AwardBadge\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/award/AwardBadge.svg\"/></div><p class=\"text-xs sm:text-sm font-roots-text tracking-tight\">2022</p><h3 class=\"text-base sm:text-lg font-semibold font-roots-text mb-1\">Global Award</h3><p class=\"text-xs sm:text-sm text-[#4A4749]/80 font-medium\">INDIA</p></div><div class=\"flex flex-col items-center\"><div class=\"relative w-28 h-28 flex items-center justify-center mb-5\"><img alt=\"AwardBadge\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/award/AwardBadge.svg\"/></div><p class=\"text-xs sm:text-sm font-roots-text tracking-tight\">2024</p><h3 class=\"text-base sm:text-lg font-semibold font-roots-text mb-1\">CSR Award</h3><p class=\"text-xs sm:text-sm text-[#4A4749]/80 font-medium\">INDIA</p></div><div class=\"flex flex-col items-center\"><div class=\"relative w-28 h-28 flex items-center justify-center mb-5\"><img alt=\"AwardBadge\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-contain\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" src=\"/award/AwardBadge.svg\"/></div><p class=\"text-xs sm:text-sm font-roots-text tracking-tight\">2025</p><h3 class=\"text-base sm:text-lg font-semibold font-roots-text mb-1\">NGO of the Year Award</h3><p class=\"text-xs sm:text-sm text-[#4A4749]/80 font-medium\">INDIA</p></div></div></div></section><section class=\"bg-[#faf1ec] py-10 px-6\"><div class=\"max-w-6xl mx-auto\"><div class=\"mb-10\"><p class=\"text-2xl font-medium text-roots-text mb-2\">Testimonials</p><h2 class=\"text-sm font-light text-roots-text\">What our partners and communities say about us</h2></div><div class=\"flex flex-col md:flex-row w-full gap-6 md:gap-8 items-stretch animate-[fadeIn_0.5s_ease-in-out]\"><div class=\"relative w-full md:w-4/12 h-72 sm:h-96 md:h-auto overflow-hidden shrink-0\"><img alt=\"Sania Nehwal\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover object-top transition-opacity duration-500\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"100vw\" srcSet=\"/_next/image?url=%2Fhome%2Fsania.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fhome%2Fsania.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fhome%2Fsania.png&amp;w=3840&amp;q=75\"/></div><div class=\"w-full md:w-8/12 bg-[#FEF9F1] flex flex-col justify-between text-left p-6 md:p-10 transition-opacity duration-500\"><p class=\"text-base sm:text-lg text-roots-text leading-relaxed mb-8 min-h-[320px] md:min-h-[220px]\">I would like to extend my heartfelt gratitude to Roots Foundation and Hyundai for initiating the Sports Lab program. This initiative demonstrates a keen understanding of the needs of sports persons, providing them with essential resources such as this fitness centre in Hisar. By addressing these needs, they ensure that athletes can focus solely on their sports without any hindrances.</p><div><h3 class=\"text-base font-bold text-[#1a1a1a]\">Sania Nehwal</h3><p class=\"text-sm text-roots-text/70 mt-1 whitespace-pre-line\">Indian Badminton Player and Olympic Medalist</p></div></div></div><div class=\"flex justify-center mt-8 gap-2\"><button class=\"w-2.5 h-2.5 rounded-full transition-all duration-300 bg-[#1a1a1a] w-6\" aria-label=\"Go to testimonial 1\"></button><button class=\"w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-400 hover:bg-gray-600\" aria-label=\"Go to testimonial 2\"></button><button class=\"w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-400 hover:bg-gray-600\" aria-label=\"Go to testimonial 3\"></button><button class=\"w-2.5 h-2.5 rounded-full transition-all duration-300 bg-gray-400 hover:bg-gray-600\" aria-label=\"Go to testimonial 4\"></button></div></div><style>\n        @keyframes fadeIn {\n          from { opacity: 0; transform: translateY(5px); }\n          to { opacity: 1; transform: translateY(0); }\n        }\n      </style></section><section class=\"bg-[#FEF9F1] py-12 px-6\"><div class=\"max-w-7xl mx-auto relative group\"><div class=\"flex flex-col md:flex-row md:items-end justify-between mb-8\"><div><h2 class=\"text-2xl sm:text-3xl font-medium text-roots-text\">LinkedIn Posts</h2><p class=\"text-sm text-roots-text font-light mt-1\">Live updates and insights from our work on the ground</p></div><div class=\"flex gap-2 mt-4 md:mt-0 select-none\"><button class=\"p-2 rounded-full border border-gray-200 bg-white hover:bg-roots-primary hover:text-white transition-all shadow-sm cursor-pointer\" aria-label=\"Scroll left\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-left w-5 h-5\" aria-hidden=\"tru