50w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg3.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-skilled p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Production-Based Learning</h3><p class=\"text-sm text-roots-text leading-relaxed\">Building skills through live orders and practical assignments.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 3\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg4.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-skilled p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Artisan Development and Quality</h3><p class=\"text-sm text-roots-text leading-relaxed\">Strengthening production systems, and quality standards.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 4\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg5.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-skilled p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Textile and Embroidery Training</h3><p class=\"text-sm text-roots-text leading-relaxed\">Training women in sewing, embroidery, and textile production.</p></div></div><div class=\"relative w-full h-full min-h-[220px] bg-[#afafaf] overflow-hidden\"><img alt=\"Focus Area 5\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 768px) 100vw, (max-width: 1200px) 50vw, 33vw\" srcSet=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fskills%2Ffocus1%2Fimg6.png&amp;w=3840&amp;q=75\"/></div><div class=\"bg-[#FEF9F1] text-center border border-roots-skilled p-8 flex flex-col justify-between min-h-[220px]\"><div><h3 class=\"text-lg font-bold text-roots-text mb-3\">Employment and Enterprise Pathways</h3><p class=\"text-sm text-roots-text leading-relaxed\">Supporting flexible work, entrepreneurship, and long-term livelihoods.</p></div></div></div></section><section class=\"py-16 px-6 sm:px-10 max-w-7xl mx-auto\"><div class=\"w-full\"><div class=\"mb-8 text-left\"><h2 class=\"text-3xl sm:text-4xl font-bold text-root-text tracking-tight mb-2\">Programs</h2></div><div class=\"p-6 sm:p-8\"><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch\"><div class=\"lg:col-span-4 h-full bg-white p-4 border border-[#d9d9d9]\"><div class=\"flex flex-col gap-2\"><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer bg-[#FEF9F1] border font-semibold\" style=\"border-color:#DC3B83;color:#1a1a1a\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-transparent\" style=\"background-color:#DC3B83\"><div class=\"w-2 h-2 rounded-full bg-white\"></div></div><span class=\"text-sm font-medium leading-snug\">Unnati</span></div></button><button class=\"w-full text-left px-4 py-3.5 transition-colors duration-200 flex items-center justify-between group cursor-pointer hover:bg-gray-50 border border-transparent text-root-text\" style=\"border-color:transparent\"><div class=\"flex items-center gap-3\"><div class=\"w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors shrink-0 border-gray-300\" style=\"background-color:transparent\"></div><span class=\"text-sm font-medium leading-snug\">Project Parali</span></div></button></div></div><div class=\"lg:col-span-8 h-full bg-white border border-[#d9d9d9] p-6 sm:p-8 flex flex-col justify-between\"><div><div class=\"border-b border-gray-100 pb-5 mb-6\"><h3 class=\"text-2xl sm:text-3xl font-bold text-root-text\">UNNATI</h3></div><div class=\"space-y-4 text-sm sm:text-base text-[#4A4749] font-light mb-6\"><p>A women-led skilling and livelihood programme supported by Acuity Knowledge Partners and Futures First.</p><p>The programme trains women in sewing, hand embroidery, machine embroidery, and textile production through flexible, production-linked learning.</p><p>It connects trainees to live work orders, quality systems, product finishing, and industry collaborations.</p><p>Project Unnati has secured ₹8 lakh worth of work orders through collaborative production partnerships.</p><p>Collaborations include Dressfolk, Amala Earth, Saffron House, Raghavendra Rathore, Aseem Design Studio, and Skinvest.</p></div><div class=\"pt-2 mb-2\"><div class=\"text-xs font-semibold text-roots-text mb-3\">Location(s)</div><div class=\"flex flex-wrap gap-3\"><span class=\"text-xs px-4 py-2.5 text-white\" style=\"background-color:#DC3B83\">Haryana</span></div></div></div></div></div><div class=\"mt-8\"><div class=\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3\"><div class=\"group relative h-28 sm:h-32 overflow-hidden\"><img alt=\"Women sewing training\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 14vw\" srcSet=\"/_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=96&amp;q=75 96w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=128&amp;q=75 128w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=256&amp;q=75 256w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=384&amp;q=75 384w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=640&amp;q=75 640w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=750&amp;q=75 750w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=828&amp;q=75 828w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=3840&amp;q=75 3840w\" src=\"/_next/image?url=%2Fskills%2Funnati%2F1.png&amp;w=3840&amp;q=75\"/></div><div class=\"group relative h-28 sm:h-32 overflow-hidden\"><img alt=\"Machine embroidery\" loading=\"lazy\" decoding=\"async\" data-nimg=\"fill\" class=\"object-cover transition-transform duration-500 group-hover:scale-105\" style=\"position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent\" sizes=\"(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 14vw\" srcSet=\"/_next/image?url=%2Fskills%2Funnati%2F2.png&amp;w=96&amp;q=75 96w, /_next/imag